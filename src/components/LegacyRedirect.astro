---
interface Props {
  destination: string;
}

const { destination } = Astro.props;
const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
const siteBase = Astro.site ?? new URL(Astro.url.origin);
const redirectTo = new URL(`${baseUrl}${destination.replace(/^\/+/, '')}`, siteBase).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Article moved</title>
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={redirectTo} />
    <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
  </head>
  <body>
    <p>This article has moved to <a href={redirectTo}>{redirectTo}</a>.</p>
  </body>
</html>
